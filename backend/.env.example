# Server
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5500
API_URL=http://localhost:4000

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pricepilot

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Email (Resend - https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx
ALERT_FROM_EMAIL=alerts@yourdomain.com

# Stripe
# 4 categories x 4 billing terms (1/3/6/12 months) = 16 recurring Prices, all in EUR.
# Create each in the Stripe dashboard (Product catalog -> Add product -> recurring price
# with the matching interval_count), then paste the price_... ID here.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# One-time (non-recurring) Prices for the two trial options. Required — signup's
# checkout step 400s with "Trial payment is not configured yet" without them.
STRIPE_PRICE_TRIAL_24H=price_xxxxxxxxxxxx
STRIPE_PRICE_TRIAL_7D=price_xxxxxxxxxxxx
STRIPE_PRICE_STANDARD_1=price_xxxxxxxxxxxx
STRIPE_PRICE_STANDARD_3=price_xxxxxxxxxxxx
STRIPE_PRICE_STANDARD_6=price_xxxxxxxxxxxx
STRIPE_PRICE_STANDARD_12=price_xxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_1=price_xxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_3=price_xxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_6=price_xxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_12=price_xxxxxxxxxxxx
STRIPE_PRICE_PREMIUMPLUS_1=price_xxxxxxxxxxxx
STRIPE_PRICE_PREMIUMPLUS_3=price_xxxxxxxxxxxx
STRIPE_PRICE_PREMIUMPLUS_6=price_xxxxxxxxxxxx
STRIPE_PRICE_PREMIUMPLUS_12=price_xxxxxxxxxxxx
STRIPE_PRICE_VIP_1=price_xxxxxxxxxxxx
STRIPE_PRICE_VIP_3=price_xxxxxxxxxxxx
STRIPE_PRICE_VIP_6=price_xxxxxxxxxxxx
STRIPE_PRICE_VIP_12=price_xxxxxxxxxxxx

# PayPal
# Same 16 combos as Billing Plans under one Product in the PayPal Developer Dashboard.
PAYPAL_CLIENT_ID=xxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=xxxxxxxxxxxx
PAYPAL_MODE=sandbox
# ID of the webhook you register in the PayPal Developer Dashboard (Apps & Credentials ->
# your app -> Webhooks). Required — incoming webhook events are rejected without it.
PAYPAL_WEBHOOK_ID=xxxxxxxxxxxx
PAYPAL_PLAN_STANDARD_1=P-xxxxxxxxxxxx
PAYPAL_PLAN_STANDARD_3=P-xxxxxxxxxxxx
PAYPAL_PLAN_STANDARD_6=P-xxxxxxxxxxxx
PAYPAL_PLAN_STANDARD_12=P-xxxxxxxxxxxx
PAYPAL_PLAN_PREMIUM_1=P-xxxxxxxxxxxx
PAYPAL_PLAN_PREMIUM_3=P-xxxxxxxxxxxx
PAYPAL_PLAN_PREMIUM_6=P-xxxxxxxxxxxx
PAYPAL_PLAN_PREMIUM_12=P-xxxxxxxxxxxx
PAYPAL_PLAN_PREMIUMPLUS_1=P-xxxxxxxxxxxx
PAYPAL_PLAN_PREMIUMPLUS_3=P-xxxxxxxxxxxx
PAYPAL_PLAN_PREMIUMPLUS_6=P-xxxxxxxxxxxx
PAYPAL_PLAN_PREMIUMPLUS_12=P-xxxxxxxxxxxx
PAYPAL_PLAN_VIP_1=P-xxxxxxxxxxxx
PAYPAL_PLAN_VIP_3=P-xxxxxxxxxxxx
PAYPAL_PLAN_VIP_6=P-xxxxxxxxxxxx
PAYPAL_PLAN_VIP_12=P-xxxxxxxxxxxx

# Polar.sh (organization access token, scope: checkouts:write)
POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxxxxxx
