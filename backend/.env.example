# Server
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5500
API_URL=http://localhost:4000

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pricepilot

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Email (Resend - https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx
ALERT_FROM_EMAIL=alerts@yourdomain.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxx
STRIPE_PRICE_GROWTH=price_xxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxx
STRIPE_PRICE_AGENCY=price_xxxxxxxxxxxx

# PayPal
PAYPAL_CLIENT_ID=xxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=xxxxxxxxxxxx
PAYPAL_MODE=sandbox
PAYPAL_PLAN_STARTER=P-xxxxxxxxxxxx
PAYPAL_PLAN_GROWTH=P-xxxxxxxxxxxx
PAYPAL_PLAN_PRO=P-xxxxxxxxxxxx
PAYPAL_PLAN_AGENCY=P-xxxxxxxxxxxx
